# Block environment/secrets files from HTTP access.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^index\.html$ /Test/index.php [R=301,L]
RewriteRule ^products\.html$ /Test/products.php [R=301,L]
RewriteRule ^cart\.html$ /Test/cart.php [R=301,L]

# Runtime schema markers must never be web-readable.
RewriteRule ^var/ - [F,L]

# Block all dotfiles: .env, .gitignore, .git, and similar.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block common project metadata and database dumps.
<FilesMatch "^(composer\.(json|lock)|env\.example|.*\.sql)$">
    Require all denied
</FilesMatch>

# Custom error pages
ErrorDocument 403 /Test/403.php
ErrorDocument 404 /Test/404.php

# ── Compression ───────────────────────────────────────────────
# HTML on this site is ~270 KB uncompressed and the CSS/JS bundle is ~800 KB.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ── Browser caching ───────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
